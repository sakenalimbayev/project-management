// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ProjectMemberRole {
  PROJECT_MEMBER
  PROJECT_ADMINISTRATOR
}

enum ProjectStatus {
  INITIATED
  PLANNED
  IN_PROGRESS
  DELAYED
  FINISHED
  SUSPENDED
  CANCELLED
}

enum StageStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum QuestionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProjectType {
  NEW_SYSTEM
  MODERNIZATION
  INTEGRATION
  SERVICE_DIGITALIZATION
  AI_SYSTEM
  INFRASTRUCTURE
  OTHER
}

enum ProjectScale {
  NATIONWIDE
  MULTIPLE_REGIONS
  SINGLE_REGION
  SINGLE_LOCALITY
}

enum FundingSource {
  REPUBLICAN_BUDGET
  LOCAL_BUDGET
  ORGANIZATION_FUNDS
  PPP
  GRANT
  OTHER
}

enum ProjectVisibility {
  DRAFT
  IN_MODERATION
  PUBLISHED
  UNPUBLISHED
}

model User {
  id        String   @id @default(uuid())
  firstName String?
  lastName  String?
  name      String?
  title     String?
  email     String   @unique
  emailVerified DateTime?
  password  String?
  role      Role     @default(USER)
  avatar    String?
  image     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedProjects      Project[]        @relation("ProjectOwner")
  projectMembers     ProjectMember[]
  accounts           Account[]
  sessions           Session[]
  authoredQuestions  Question[]       @relation("QuestionAuthor")
  moderatedQuestions Question[]       @relation("QuestionModerator")
  notifications      Notification[]   @relation("NotificationRecipient")
  notificationPreference NotificationPreference?
  auditLogEntries    AuditLogEntry[]  @relation("AuditLogActor")
  uploadedDocuments  ProjectDocument[] @relation("ProjectDocumentUploader")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id          String  @id @default(uuid())
  name        String
  shortName   String?
  description String?
  category    String?
  projectType ProjectType?

  totalBudget  Decimal       @db.Decimal(15, 2)
  spentAmount  Decimal       @default(0) @db.Decimal(15, 2)
  status       ProjectStatus @default(PLANNED)

  ownerId String
  owner   User   @relation("ProjectOwner", fields: [ownerId], references: [id])

  ministryId String
  ministry   Ministry @relation(fields: [ministryId], references: [id])

  responsibleOrganization String?
  projectManagerName      String?
  officialContactEmail    String?

  goal String?

  scale ProjectScale?

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  startDate      DateTime? @db.Date
  plannedEndDate DateTime? @db.Date
  actualEndDate  DateTime? @db.Date

  fundingSources FundingSource[]

  infoAsOfDate   DateTime?         @db.Date
  nextUpdateDate DateTime?         @db.Date
  visibility     ProjectVisibility @default(DRAFT)

  members       ProjectMember[]
  questions     Question[]
  stages        ProjectStage[]
  documents     ProjectDocument[]
  kpis          ProjectKpi[]
  yearlyBudgets ProjectYearlyBudget[]
  notifications Notification[]
  auditLogEntries AuditLogEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([ministryId])
  @@index([locationId])
}

model ProjectKpi {
  id            String @id @default(uuid())
  projectId     String
  name          String
  baselineValue String
  targetValue   String
  unit          String?
  sortOrder     Int    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model ProjectYearlyBudget {
  id            String  @id @default(uuid())
  projectId     String
  year          Int
  plannedAmount Decimal @default(0) @db.Decimal(15, 2)
  actualAmount  Decimal @default(0) @db.Decimal(15, 2)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, year])
}

model ProjectDocument {
  id           String  @id @default(uuid())
  projectId    String
  fileName     String
  fileUrl      String
  fileSize     Int
  mimeType     String
  documentType String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  uploadedById String?
  uploadedBy   User?   @relation("ProjectDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([projectId])
}

model ProjectStage {
  id            String      @id @default(uuid())
  projectId     String
  label         String
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  status        StageStatus @default(PLANNED)
  plannedBudget Decimal     @default(0) @db.Decimal(15, 2)
  sortOrder     Int         @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String

  role      ProjectMemberRole @default(PROJECT_MEMBER)

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  joinedAt DateTime @default(now())

  @@unique([projectId, userId])
}

model Ministry {
  id       String    @id @default(uuid())
  name     String    @unique
  projects Project[]
}
 
model Location {
  id        String   @id @default(uuid())
  city      String?
  region    String?
  latitude  Float?
  longitude Float?

  projects Project[]

  @@unique([city, region])
}

model Question {
  id           String         @id @default(uuid())
  projectId    String
  authorId     String?
  text         String
  answer       String?
  status       QuestionStatus @default(APPROVED)
  approvedAt   DateTime?
  approvedById String?

  project    Project @relation(fields: [projectId], references: [id])
  author     User?   @relation("QuestionAuthor", fields: [authorId], references: [id])
  approvedBy User?   @relation("QuestionModerator", fields: [approvedById], references: [id])
  notifications Notification[]
  auditLogEntries AuditLogEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([authorId])
  @@index([status])
}

enum NotificationType {
  PROJECT_CREATED
  PROJECT_UPDATED
  QUESTION_SUBMITTED
  QUESTION_ANSWERED
  QUESTION_REJECTED
}

model Notification {
  id          String           @id @default(uuid())
  type        NotificationType
  title       String
  message     String
  category    String
  actorLabel  String
  important   Boolean          @default(false)
  readAt      DateTime?
  archivedAt  DateTime?

  recipientId String
  recipient   User    @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  questionId String?
  question   Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
  @@index([recipientId, archivedAt])
}

model NotificationPreference {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  email Boolean @default(true)
  push  Boolean @default(true)
  sms   Boolean @default(false)
  slack Boolean @default(false)

  updatedAt DateTime @updatedAt
}

enum AuditLogAction {
  PROJECT_ATTRIBUTE_CHANGED
  QUESTION_ADDED
  QUESTION_ANSWERED
}

model AuditLogEntry {
  id         String         @id @default(uuid())
  action     AuditLogAction
  attribute  String?
  summary    String
  actorLabel String

  actorId String?
  actor   User?   @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  questionId String?
  question   Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([action, createdAt])
  @@index([attribute])
}

